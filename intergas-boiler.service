[Unit]
Description=Intergas HRE Boiler Monitoring
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/IntergasHREBoilerReader
Type=simple
ExecStart=/usr/bin/screen -DmS boiler /usr/bin/python3 /home/pi/IntergasHREBoilerReader/intergas_hre.py --mqtt-user mqtt_user --mqtt-password sklxmue932u42sw --port /dev/serial/by-id/usb-FTDI_FT232R_USB_UART_BG018Y11-if00-port0 
ExecStop=/usr/bin/screen -S boiler -X quit
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
